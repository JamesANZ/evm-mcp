# EVM MCP Server Configuration

# Built-in provider API keys (optional if using CUSTOM_PROVIDERS or CUSTOM_NETWORKS with rpcUrl)
INFURA_API_KEY=your-infura-api-key
# ALCHEMY_API_KEY=your-alchemy-api-key

# Defaults
DEFAULT_NETWORK=ethereum
DEFAULT_PROVIDER=infura
RPC_PROVIDER_ORDER=infura,alchemy

# User-defined providers (JSON array string)
# CUSTOM_PROVIDERS=[{"slug":"quicknode","apiKeyEnv":"QUICKNODE_API_KEY","baseUrl":"https://rpc.example.com/v1/{apiKey}","networkUrls":{"ethereum":"https://eth.quiknode.pro/{apiKey}/","polygon":"https://polygon.quiknode.pro/{apiKey}/"}}]

# User-defined networks (JSON array string)
# CUSTOM_NETWORKS=[{"name":"HyperEVM","slug":"hyperevm","chainId":999,"rpcUrl":"https://rpc.hyperliquid.xyz/evm","nativeCurrency":{"symbol":"HYPE","decimals":18}}]
